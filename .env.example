# Copy to .env and adjust. `.env` is gitignored — never commit it.
#
# The values below are LOCAL DEVELOPMENT DEFAULTS only. They match the
# credentials in docker-compose.yml, which binds Postgres and Redis to
# localhost only. Do not reuse this password anywhere that is reachable
# from outside this machine.

# ---- Postgres ----
# Consumed by docker-compose.yml to provision the container, and by the
# Go services to connect. Keep these in sync with DATABASE_URL below.
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex_local_dev_only
POSTGRES_DB=cortex
POSTGRES_PORT=5432

DATABASE_URL=postgres://cortex:cortex_local_dev_only@localhost:5432/cortex?sslmode=disable

# ---- Redis ----
REDIS_PORT=6379
REDIS_ADDR=localhost:6379

# ---- Ollama (native host install, unauthenticated on loopback) ----
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# ---- Services ----
API_PORT=8080
WORKER_HEALTH_PORT=8081
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# ---- M3: concept extraction (unused in M1) ----
# Leave blank to use a local Ollama model instead of the hosted API.
ANTHROPIC_API_KEY=
