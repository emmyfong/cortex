# Copy to .env and adjust. `.env` is gitignored — never commit it.
#
# The values below are LOCAL DEVELOPMENT DEFAULTS only. They match the
# credentials in docker-compose.yml, which binds Postgres and Redis to
# localhost only. Do not reuse this password anywhere that is reachable
# from outside this machine.

# ---- Postgres ----
# Consumed by docker-compose.yml to provision the container, and by the
# Go services to connect. Keep these in sync with DATABASE_URL below.
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex_local_dev_only
POSTGRES_DB=cortex
POSTGRES_PORT=5432

DATABASE_URL=postgres://cortex:cortex_local_dev_only@localhost:5432/cortex?sslmode=disable

# ---- Redis ----
REDIS_PORT=6379
REDIS_ADDR=localhost:6379

# ---- Ollama (native host install, unauthenticated on loopback) ----
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# ---- Services ----
API_PORT=8080
WORKER_HEALTH_PORT=8081
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# ---- Chunking ----
# The biggest lever on search quality. A token is roughly 3/4 of a word, so
# 600 tokens is about 450 words — large enough to hold one complete idea,
# small enough that its embedding stays about a single topic.
# Overlap repeats the tail of each chunk at the start of the next, so an idea
# spanning a cut point is still retrievable. Must be less than CHUNK_MAX_TOKENS.
# Changing either value requires re-ingesting existing sources.
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=50

# ---- Ingestion ----
# PDF text extraction shells out to pdftotext (poppler). Git for Windows bundles
# one at C:\Program Files\Git\mingw64\bin\pdftotext.exe; otherwise install with
# `winget install oschwartz10612.Poppler`. Set an absolute path if it is not on PATH.
PDFTOTEXT_PATH=pdftotext
MAX_UPLOAD_BYTES=52428800
MAX_FETCH_BYTES=10485760

# ---- Search ----
SEARCH_DEFAULT_K=5
SEARCH_MAX_K=50

# ---- M3: concept extraction (unused in M1) ----
# Leave blank to use a local Ollama model instead of the hosted API.
ANTHROPIC_API_KEY=
